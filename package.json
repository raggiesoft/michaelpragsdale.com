{
  "name": "michaelpragsdale-portfolio-v1",
  "version": "1.0.0",
  "description": "Asset compiler for the v1 vanilla PHP portfolio site.",
  "scripts": {
    "watch:scss": "sass --watch uncompiled-assets/scss:public/assets/css",
    "watch:js": "esbuild uncompiled-assets/js/*.js --outdir=public/assets/js --watch",
    "dev": "npm-run-all --parallel watch:*",
    "build:scss": "sass uncompiled-assets/scss:public/assets/css --style=compressed",
    "build:js": "esbuild uncompiled-assets/js/*.js --minify --outdir=public/assets/js",
    "build": "npm-run-all --parallel build:*"
  },
  "author": "Michael Ragsdale",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.9",
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.4"
  }
}
